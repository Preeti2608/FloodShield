# ==============================================================================
# FloodShield Frontend Environment Variables Template
# Copy this file to .env (or .env.local) for local development.
#
# SECURITY NOTICE:
# - All variables prefixed with VITE_* are bundled into the public browser build.
# - NEVER put AWS credentials (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) here!
# - The browser communicates ONLY via HTTPS to the AWS API Gateway endpoint.
# ==============================================================================

# AWS API Gateway HTTP API Endpoint Base URL
# - Production with AWS: Set to your deployed API Gateway endpoint.
#   Example: https://abcdef1234.execute-api.ap-south-1.amazonaws.com
# - Local / Standalone Demo: Leave empty to run with local browser storage.
VITE_API_BASE_URL=

# Data Mode Switcher
# - Set to "false" in Production to connect to live AWS DynamoDB & Lambda.
# - Set to "true" for standalone offline/demo mode using local mock data.
VITE_USE_MOCK_DATA=false

# Application Environment Name (development | production | staging)
VITE_APP_ENV=production

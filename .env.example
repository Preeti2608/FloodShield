# FloodShield Environment Variables Template
# Copy this file to .env for local development.

# AWS API Gateway HTTP API Endpoint Base URL (Configured by AWS backend teammate)
# Leave empty for local browser-storage mode and fallback weather/geocoding feeds.
# Example: https://abc123xyz.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=

# Data Mode Switcher (true = Local Demo Mock Mode, false = Live AWS API Gateway Backend)
VITE_USE_MOCK_DATA=true

# Environment Name (development / production / hackathon)
VITE_APP_ENV=hackathon

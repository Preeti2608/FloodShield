# ==============================================================================
# FloodShield Backend Environment Variables Template
# Copy this file to backend/.env for local administration or test scripts.
#
# SECURITY NOTICE:
# - NEVER commit backend/.env to Git or expose credentials in public repos.
# - In deployed AWS Lambda, IAM roles provide credentials automatically.
# - Static AWS credentials below are ONLY for local deployment scripts (deploy.mjs / test-and-verify.mjs).
# ==============================================================================

# AWS Region where resources are deployed
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# Amazon DynamoDB Table Name for Citizen Incident Reports
TABLE_NAME=FloodShield-Incidents

# Application Environment Name (hackathon | dev | prod)
APP_ENV=hackathon

# Amazon Bedrock Foundation Model Access (Optional)
ENABLE_BEDROCK=false
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ------------------------------------------------------------------------------
# LOCAL CLI TOOLS ONLY (deploy.mjs, check-permissions.mjs, test-and-verify.mjs)
# In production Lambda execution, IAM role policies grant permissions instead.
# DO NOT COMMIT REAL KEYS TO SOURCE CONTROL!
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
